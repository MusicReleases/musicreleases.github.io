@using JakubKastner.MusicReleases.Spotify.Tasks


<div class="@TaskClass" @onclick="ViewTask">

    <div class="header">

        <span class="title">
            @BackgroundTask.Name
        </span>

        <div class="icon">
            @if (BackgroundTask.Ended)
            {
                <MrButton Class="task" OnClick="@HideTask" Title="Hide task">
                    <MrIcon Icon="@LucideIcon.X" />
                </MrButton>
            }
            else
            {
                <MrIcon Icon="LucideIcon.LoaderCircle" Spin="@(BackgroundTask.Status == BackgroundTaskStatus.Running)" />
            }
        </div>

    </div>

    <div class="status">

        @if (BackgroundTask.CurrentStep is not null && BackgroundTask.CurrentStep.IsWaiting && BackgroundTask.CurrentStep.WaitingForStepId.HasValue)
        {
            <span>
                Waiting for @(BackgroundTask.GetStepLabel(BackgroundTask.CurrentStep.WaitingForStepId.Value) ?? "dependency")
            </span>
        }
        else
        {
            <span>
                @BackgroundTask.StatusText
            </span>
        }

        @if (BackgroundTask.CurrentStep is not null)
        {
            <span>
                &nbsp;(@BackgroundTask.CurrentStep.Name)
            </span>
        }

    </div>

</div>